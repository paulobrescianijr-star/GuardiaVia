{
  "name": "guardiavia",
  "displayName": "GuardiaVia",
  "version": "2.0.0",
  "description": "Proteção veicular e saúde em tempo real",
  "main": "index.html",
  "scripts": {
    "build": "cordova build android",
    "build-debug": "cordova build android --debug",
    "build-release": "cordova build android --release",
    "run": "cordova run android",
    "emulate": "cordova emulate android"
  },
  "keywords": ["guardiavia", "safety", "health", "gps", "bluetooth"],
  "author": "Paulo Sergio Bresciani Junior",
  "license": "MIT",
  "dependencies": {
    "cordova-android": "^13.0.0",
    "cordova-plugin-vibration": "^3.1.1",
    "cordova-plugin-geolocation": "^5.0.0",
    "cordova-plugin-bluetoothle": "^6.7.4",
    "cordova-plugin-whitelist": "^1.3.5"
  },
  "devDependencies": {
    "cordova": "^12.0.0"
  },
  "cordova": {
    "plugins": {
      "cordova-plugin-vibration": {},
      "cordova-plugin-geolocation": {
        "GPS_REQUIRED": "true"
      },
      "cordova-plugin-bluetoothle": {},
      "cordova-plugin-whitelist": {}
    },
    "platforms": [
      "android"
    ]
  }
}
